shaders = 17

#Curved bezel texture path:
	monitor_body_curved = "../koko-aio-19/textures/monitor_body_curved.png"

#Straight bezel texture path:
	monitor_body_straight = "../koko-aio-19/textures/monitor_body_straight.png"
	
#Background texture path:
	bg_under = "../koko-aio-19/textures/background_under.png"

#Foreground texture path:
	bg_over = "../Duimon_additional_presets/textures/logo_Wii.png"

#Backdrop texture
   backdrop = "../koko-aio-19/textures/boothill.jpg"
    
#Shader files paths:
	shader0 = "../koko-aio-19/shaders-ng/colortools_and_ntsc_pass.slang"
	shader1 = "../koko-aio-19/shaders-ng/flick_and_noise.slang"
	shader2 = "../koko-aio-19/shaders-ng/fxaa.slang"    
	shader3 = "../koko-aio-19/shaders-ng/shift_and_bleed.slang"    
	shader4 = "../koko-aio-19/shaders-ng/in_glow_x.slang"
	shader5 = "../koko-aio-19/shaders-ng/in_glow_y.slang"    
	shader6 = "../koko-aio-19/shaders-ng/halo_pre_gamma.slang"
	shader7 = "../koko-aio-19/shaders-ng/halo.slang"
	shader8 = "../koko-aio-19/shaders-ng/avglum_pass.slang"
	shader9 = "../koko-aio-19/shaders-ng/reflection_blur_pre.slang"      
	shader10 = "../koko-aio-19/shaders-ng/reflection_blur.slang"
	shader11 = "../koko-aio-19/shaders-ng/bloom_pass_1.slang"
	shader12 = "../koko-aio-19/shaders-ng/bloom_pass_2.slang"        
	shader13 = "../koko-aio-19/shaders-ng/bloom_pass_3.slang"
	shader14 = "../koko-aio-19/shaders-ng/bloom_pass_4.slang"
	shader15 = "../koko-aio-19/shaders-ng/ambi_temporal_pass.slang"
	shader16 = "../koko-aio-19/shaders-ng/final_pass.slang"
	
textures = "monitor_body_curved;monitor_body_straight;bg_under;bg_over;backdrop"


     monitor_body_curved_linear = "true"
  monitor_body_curved_wrap_mode = "clamp_to_edge"
     monitor_body_curved_mipmap = "true"

     monitor_body_straight_linear = "true"
  monitor_body_straight_wrap_mode = "clamp_to_edge"
     monitor_body_straight_mipmap = "true"
     
         bg_under_linear = "true"
      bg_under_wrap_mode = "mirrored_repeat"
         bg_under_mipmap = "false"
         
          bg_over_linear = "true"
       bg_over_wrap_mode = "mirrored_repeat"
          bg_over_mipmap = "false"

        #This is for support for arcade backdrop pictures, enable it in config.inc.
         backdrop_linear = "true"
      backdrop_wrap_mode = "mirrored_repeat"
         backdrop_mipmap = "true"



            alias0 = "colortools_and_ntsc_pass"
#float_framebuffer needed by phosphor persistance
float_framebuffer0 = true
    filter_linear0 = false
       scale_type0 = source
            scale0 = 1.0
        wrap_mode0 = "clamp_to_border"

            alias1 = "flick_and_noise_pass"
    filter_linear1 = false
       scale_type1 = source
       
      #Set scale1 to 1.0 to gain performance when                   /// PERFORMANCE GAIN HERE
      #content is already at hi resolution (dreamcast,gamecube..)
      # scale1 = 2.0   
        scale1 = 1.0
       
        wrap_mode1 = "mirrored_repeat"

            alias2 = "FXAA_pass"
    filter_linear2 = true
       scale_type2 = source
            scale2 = 1.0
     mipmap_input2 = true
        wrap_mode2 = "mirrored_repeat"

            alias3 = "shift_and_bleed_pass"
    filter_linear3 = true
            scale3 = 1.0
       scale_type3 = source
float_framebuffer3 = true
     mipmap_input3 = false
        wrap_mode3 = "mirrored_repeat"

            alias4 = "in_glow_pass_x"
    filter_linear4 = true
            scale4 = 1.0
       scale_type4 = source    
float_framebuffer4 = true
        wrap_mode4 = "mirrored_repeat"
     mipmap_input4 = true
       
            alias5 = "in_glow_pass"
    filter_linear5 = true
            scale5 = 1.0
       scale_type5 = source    
float_framebuffer5 = true
        wrap_mode5 = "mirrored_repeat"
    
            alias6 = "halo_pre_gamma_pass"
    filter_linear6 = true
            scale6 = 1.0
       scale_type6 = source
float_framebuffer6 = true
     mipmap_input6 = false
        wrap_mode6 = "clamp_to_edge"

            alias7 = "halo_pass"
    filter_linear7 = true
            scale7 = 1.0
       scale_type7 = source
float_framebuffer7 = true
     mipmap_input7 = false
        wrap_mode7 = "clamp_to_edge"

            alias8 = "avglum_pass"
    filter_linear8 = true
       scale_type8 = source
             scale8 = 0.5
         wrap_mode8 = "mirrored_repeat"
      mipmap_input8 = false

           alias9 = "reflected_blurred_pass_pre"
   filter_linear9 = true
      scale_type9 = source
          scale9  = 1.0
       wrap_mode9 = "clamp_to_border"

                alias10 = "reflected_blurred_pass"
        filter_linear10 = true
           scale_type10 = source
                scale10 = 1.0
         mipmap_input10 = false
            wrap_mode10 = "mirrored_repeat"

                alias11 = "bloom_pass_1"
        filter_linear11 = true
           scale_type11 = source
                scale11 = 1.0
            wrap_mode11 = "mirrored_repeat"
 
                alias12 = "bloom_pass_2"
        filter_linear12 = true
           scale_type12 = source
                scale12 = 0.5
            wrap_mode12 = "clamp_to_edge"

                alias13 = "bloom_pass_3"
        filter_linear13 = true
           scale_type13 = source
                scale13 = 1.0
            wrap_mode13 = "clamp_to_edge"

                alias14 = "bloom_pass_final"
        filter_linear14 = true
           scale_type14 = source
                scale14 = 1.0
            wrap_mode14 = "mirrored_repeat"
    float_framebuffer14 = "true"

                alias15 = "ambi_temporal_pass"
        filter_linear15 = true
           scale_type15 = viewport
                scale15 = 0.05
            wrap_mode15 = "clamp_to_border"
    float_framebuffer15 = true
    
            alias16 = "final_pass"
    filter_linear16 = true
       scale_type16 = viewport
            scale16 = 1.0
        wrap_mode16 = "mirrored_repeat"
        




DO_CCORRECTION = "1.000000"
IN_GLOW_POWER = "1.300000"
LUMINANCE = "0.200000"
TEMPERATURE = "7200.000000"
IN_GLOW_GAMMA = "2.000000"
GAMMA_OUT = "0.430000"
DO_SHIFT_RGB = "1.000000"
OFFSET_STRENGTH = "0.300000"
SHIFT_R = "-20.000000"
SHIFT_G = "0.000000"
SHIFT_B = "20.000000"
DO_IN_GLOW = "1.000000"
IN_GLOW_W = "-0.850000"
IN_GLOW_H = "7.000000"
DO_PIXELGRID = "1.000000"
PIXELGRID_H_PRST = "1.000000"
PIXELGRID_MAX_W = "0.400000"
PIXELGRID_GAMMA_W = "1.500000"
PIXELGRID_BASAL_GRID = "0.020000"
PIXELGRID_MIN_H = "0.300000"
PIXELGRID_MAX_H = "0.700000"
PIXELGRID_H_ANTIMOIRE = "0.000000"
